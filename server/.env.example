# Penner Kombat Relay — Beispiel-Konfiguration
# Kopiere nach .env (wird von docker compose --env-file gelesen) und passe an.
PORT=5000
HOST=0.0.0.0
WS_PATH=/kombat
MAX_PLAYERS=4
HEARTBEAT_MS=15000
IDLE_ROOM_MS=300000
# Matchmaking: true = Spieler werden automatisch gepaart
MATCHMAKING_ENABLED=true
# Wie lange ein Spieler maximal wartet, bevor die Warteschlange ihn entfernt
MATCHMAKING_TIMEOUT_MS=90000
