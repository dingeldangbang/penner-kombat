{
  "name": "penner-kombat-3d",
  "version": "1.0.0",
  "description": "Penner Kombat 3D — Le Binde vs Mojo Bob Pose Arena, 100% spielbare Kombos",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "serve:3d": "python3 -m http.server 8000",
    "test": "node --test test/sim.test.mjs test/lab.test.mjs test/engine.test.mjs",
    "cap:init": "npx cap init \"Penner Kombat 3D\" com.dingelanggames.pennerkombat --web-dir=.",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "lab": "node ../server/src/ai-proxy.js",
    "test:ui": "node --import ./test/helpers/register.mjs --test test/ui.dom.test.mjs",
    "test:all": "npm test && npm run test:ui",
    "check:browser": "node ../Tools/lab_browser_check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^5.7.0",
    "@capacitor/android": "^5.7.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "jsdom": "^24.0.0"
  },
  "keywords": [
    "fighting",
    "3d",
    "pose",
    "webgl",
    "penner",
    "kombat"
  ],
  "author": "Dingelang Games",
  "license": "CC-BY-NC-4.0"
}
