; Engine configuration for Penner Kombat Godot/mobile runtime.
config_version=5

[application]
config/name="PennerKombat"
config/version="1.0.0"
config/description="Dynamic GLB Combat System with OpenAI Integration"
run/main_scene="res://scenes/ui/Editor.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/handheld/orientation=6

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_etc2_astc/high_quality=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.1, 0.08, 0.12, 1)

[audio]
driver/output_latency=15

[input_devices]
pointing/emulate_touch_from_mouse=true

[application/config]
name="PennerKombat"

[android]
package/unique_name="com.pennerkombat.mobile"
package/name="com.pennerkombat.mobile"
package/version=1
package/version_code=1
permissions/internet=true
permissions/access_network_state=true
permissions/read_external_storage=true
permissions/write_external_storage=true
permissions/vibrate=true
min_sdk_version=30
target_sdk_version=33

[android/splash]
show=true
fullscreen=true

[shader_globals]
xray_uniform={"type":"color","value":Color(0, 0, 0, 0)}

[autoload]
GlobalData="*res://scripts/autoload/GlobalData.gd"
